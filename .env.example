# Production origin — backs metadataBase, the sitemap, and robots.txt
# (see config/site.ts). Falls back to https://cloverindustries.co.bw
# (the domain implied by the contact emails) if unset.
NEXT_PUBLIC_SITE_URL=https://cloverindustries.co.bw

# Sanity — Clover Industries project
# Copy this file to .env.local and fill in real values (.env.local is gitignored).
NEXT_PUBLIC_SANITY_PROJECT_ID=qt8a89j9
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Studio origin — used for stega (click-to-edit links back to the Studio)
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Read token (Viewer role). Create at:
# https://www.sanity.io/manage/project/qt8a89j9/api/tokens
# Server-only — never prefix with NEXT_PUBLIC. Do NOT commit a real token here.
SANITY_API_READ_TOKEN=

# Resend — transactional email for the RFQ and contact forms (CI Sprint 5)
# Create a key at https://resend.com/api-keys (sending access is enough).
# Server-only — never prefix with NEXT_PUBLIC. Do NOT commit a real key here.
# Without it, development only logs emails; production refuses to send.
RESEND_API_KEY=

# Optional. The Google Workspace mailbox for everything website-related. It is
# the sender, always CC'd on RFQs and contact enquiries, and where replies land.
# Defaults to info@cloverindustries.co.bw.
EMAIL_WEBSITE_INBOX=

# Optional. The sender, on the domain verified in Resend. Defaults to
# "Clover Industries <EMAIL_WEBSITE_INBOX>".
EMAIL_FROM=

# Optional. Each RFQ / contact enquiry is one email to the buyer with the division
# inbox(es) on CC. When this is set, that CC (and the Reply-To) becomes this one
# address instead — use it on preview/staging and while testing. The buyer still
# receives their email.
EMAIL_INBOX_OVERRIDE=
